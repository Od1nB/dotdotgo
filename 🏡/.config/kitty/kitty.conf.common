# Shared by kitty.conf.darwin and kitty.conf.linux, both of which `include` this
# file as their first line. Anything here must be OS-neutral; per-OS values and
# bindings live in the including file, which wins on conflict (last definition
# wins for scalar options, and a later `map` for the same key replaces earlier).
#
# `kitty.conf` itself is a symlink to kitty.conf.$(uname|lower), generated by
# scripts/linkers.sh and deliberately not tracked in git.

# purple
background              #221630
background_opacity      0.95

cursor                  #e0b0ff
cursor_text_color       #221630

cursor_trail            3
cursor_trail_decay      0.1 0.4

# font_size is per-OS -- see the including file.
font_family             family="JetBrains Mono" features="-liga -calt -dlig"

tab_bar_style           custom
tab_bar_edge            top
tab_bar_min_tabs        1
tab_bar_background      #221630
active_tab_background   #3a2450
active_tab_foreground   #e0b0ff
inactive_tab_background #221630
inactive_tab_foreground #8a7a9b
active_tab_font_style   normal
inactive_tab_font_style normal

active_border_color     #ff6ec7
inactive_border_color   #3a2450

enabled_layouts splits:split_axis=horizontal,stack

# Session membership rides on cwd inheritance: only the *_with_cwd actions and
# `launch --cwd=current` pass the active session on to what they create. The
# keys below all default to the plain variants, which silently produce
# sessionless windows, so they are overridden rather than left as shadows.
# The macOS cmd+ equivalents are in kitty.conf.darwin.
map ctrl+shift+t        new_tab_with_cwd
map ctrl+shift+enter    new_window_with_cwd
map ctrl+shift+n        new_os_window_with_cwd

startup_session         ~/.local/share/kitty/sessions/dotfiles.kitty-session

# `session:.` (this tab's session is the active one) rather than `session:~`:
# despite reading like "current session", `~` matches active-session OR
# most-recent-session (tabs.py, Tab.matches_query), where most-recent is
# goto_session_history[-1] -- appended to only by goto_session and by loading a
# session file, never by focusing a tab. With startup_session seeding that
# history, `~` left the startup session's tabs pinned in every other session's
# bar. kitty means it as context for sessionless windows; here it is noise.
#
# No `or session:^$` clause either: nothing should be sessionless now, so a tab
# that turns up in every session's bar is a leak worth seeing rather than hiding.
tab_bar_filter          session:.

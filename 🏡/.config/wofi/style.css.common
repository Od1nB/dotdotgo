#window {
	background-color: @ground;
	border: 1px solid @rule;
	border-radius: 6px;
	font-family: "JetBrains Mono";
	font-size: 13px;
	font-feature-settings: "liga" 0, "calt" 0, "dlig" 0, "tnum" 1;
	color: @text;
}

#outer-box {
	background-color: transparent;
	padding: 10px;
}

#input {
	background-color: transparent;
	background-image: none;
	border: none;
	border-bottom: 1px solid @rule;
	border-radius: 0;
	box-shadow: none;
	outline-style: none;
	padding: 6px 12px;
	margin: 0;
	color: @text;
	caret-color: @accent;
}

#scroll {
	background-color: transparent;
	margin-top: 8px;
}

#inner-box {
	background-color: transparent;
}

#entry {
	background-color: transparent;
	padding: 6px 12px;
	border: 1px solid transparent;
	transition: color 120ms;
}

#entry:selected,
#selected {
	background-color: transparent;
	border-color: @accent;
	color: @accentBright;
}

#entry:selected #text,
#selected #text {
	color: @accentBright;
}

#entry:hover {
	color: @accentDim;
}

#entry:hover #text {
	color: @accentDim;
}

#text {
	background-color: transparent;
	color: inherit;
}

#unselected {
	color: @muted;
}

#img {
	background-color: transparent;
	margin-right: 10px;
	min-width: 20px;
	min-height: 20px;
}

#scroll scrollbar {
	background-color: transparent;
	border: none;
}

#scroll scrollbar trough {
	background-color: transparent;
	border: none;
}

#scroll scrollbar slider {
	background-color: @rule;
	border: none;
	border-radius: 6px;
	min-width: 4px;
}
